# Episode cloud server — copy to `.env` and fill in (all optional).
# Without MONGO_URL the server refuses to start and the creator's
# Save-to-cloud / Load-by-code buttons render disabled (file import/export
# keeps working).
#
# VERCEL: skip this file — set MONGO_URL (+ optional MONGO_DB) in the
# dashboard (Project → Settings → Environment Variables) and redeploy.
# api/* serverless functions share server/core.js, so same-origin /api just
# works with no VITE_* setting. Standalone `node server/index.js` remains
# for non-Vercel hosts.

# MongoDB Atlas connection string (server-side only — never expose to browsers)
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority"
# Database name
MONGO_DB="buzzers"
# API listen port (defaults to 3001)
PORT=3001
# Behind a reverse proxy? Trust X-Forwarded-For so rate limits key on the
# real client IP. Leave unset for direct hosting (a client could otherwise
# spoof the header to rotate limit identities).
# TRUST_PROXY=1
# Optional rate-limit tuning (requests per 15 min per IP; overwrite guesses
# are per IP + code). Defaults: 300 general, 30 saves, 15 overwrites.
# RATE_GENERAL_MAX=300
# RATE_SAVE_MAX=30
# RATE_OVERWRITE_MAX=15

# Frontend (Vite): base URL the creator uses to reach the API. OPTIONAL —
# the client defaults to same-origin /api, which `npm run dev` proxies to
# localhost:3001 (see vite.config.js), so local dev needs no setting at all.
# Only set this for a cross-origin API, or a same-origin prod deploy without
# an /api route. NOTE: Vite reads this at startup — restart dev after changing.
# VITE_EPISODE_API_URL="http://localhost:3001"
